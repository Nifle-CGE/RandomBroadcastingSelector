{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "rbs",
	"keep_vars": false,
	"send_metrics": false,
	"compatibility_date": "2026-03-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"build": {
		"command": "bun run build"
	},
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "rbs",
			"database_name": "rbs",
			"database_id": "f39bb960-edb8-45c7-a0b3-70ff7467624d"
		}
	]
}